{
  "name": "appsline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Appsline — recreation of the reference video's design system in HTML, SCSS, GSAP and Three.js.",
  "scripts": {
    "css": "sass src/scss/main.scss src/css/main.css --style=expanded --no-source-map",
    "css:min": "sass src/scss/main.scss src/css/main.css --style=compressed --no-source-map",
    "js": "esbuild src/js/main.js --bundle --format=iife --target=es2019 --minify --outfile=src/js/bundle.js",
    "watch": "sass --watch src/scss/main.scss:src/css/main.css --no-source-map",
    "watch:js": "esbuild src/js/main.js --bundle --format=iife --target=es2019 --outfile=src/js/bundle.js --watch",
    "mask": "node tools/build-land-mask.mjs",
    "serve": "node tools/serve.mjs",
    "shot": "node tools/shoot.mjs",
    "build": "npm run mask && npm run css && npm run js",
    "dev": "npm run css && npm run js && npm run serve"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sass": "^1.99.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "ws": "^8.21.3"
  }
}
